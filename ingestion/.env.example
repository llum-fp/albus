# Confluence credentials — required for live ingestion (Phase 2).
# Copy to .env (never commit .env) and fill in your values.
#
# Get an API token at: https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_URL=https://yourcompany.atlassian.net
CONFLUENCE_USER=email@company.com
CONFLUENCE_API_TOKEN=<your-api-token>

# Confluence space key to pull from when running the ingestion CLI.
# Set this (or pass --confluence-space <KEY>) to switch from the offline corpus to live Confluence.
# Leave unset to use the hand-written corpus/*.json stub (default, zero-dependency).
ALBUS_CONFLUENCE_SPACE=ENG
